{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BananaJeanss/solsleep/blob/main/schemas/challenge-pack-1.schema.json",
  "title": "SolSleep native challenge pack v1",
  "description": "Editor assistance. Host additionally enforces strict UTF-8, 48 KiB, depth, duplicate fields, Unicode validity, and ORDER permutation/CHOICE index bounds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "title", "levels"],
  "properties": {
    "format": {"const": "solsleep-challenge-pack"},
    "version": {"const": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "levels": {
      "type": "object", "additionalProperties": false,
      "required": ["EASY", "NORMAL", "HARD"],
      "properties": {
        "EASY": {"$ref": "#/$defs/bank"},
        "NORMAL": {"$ref": "#/$defs/bank"},
        "HARD": {"$ref": "#/$defs/bank"}
      }
    }
  },
  "$defs": {
    "bank": {"type":"array", "minItems":1, "maxItems":24, "items":{"$ref":"#/$defs/task"}},
    "prompt": {"type":"string", "minLength":1, "maxLength":600},
    "choices": {"type":"array", "minItems":2, "maxItems":9, "uniqueItems":true, "items":{"type":"string", "minLength":1, "maxLength":120}},
    "order": {"type":"array", "minItems":1, "maxItems":9, "uniqueItems":true, "items":{"type":"integer", "minimum":0, "maximum":8}},
    "task": {
      "oneOf": [
        {"type":"object", "additionalProperties":false, "required":["kind","prompt","answer","caseSensitive"],
         "properties":{"kind":{"const":"TEXT"},"prompt":{"$ref":"#/$defs/prompt"},"answer":{"type":"string","minLength":1,"maxLength":120},"caseSensitive":{"type":"boolean"}}},
        {"type":"object", "additionalProperties":false, "required":["kind","prompt","choices","order"],
         "properties":{"kind":{"const":"CHOICE"},"prompt":{"$ref":"#/$defs/prompt"},"choices":{"$ref":"#/$defs/choices"},"order":{"allOf":[{"$ref":"#/$defs/order"},{"maxItems":1}]}}},
        {"type":"object", "additionalProperties":false, "required":["kind","prompt","choices","order"],
         "properties":{"kind":{"const":"ORDER"},"prompt":{"$ref":"#/$defs/prompt"},"choices":{"$ref":"#/$defs/choices"},"order":{"allOf":[{"$ref":"#/$defs/order"},{"minItems":2}]}}}
      ]
    }
  }
}
